<Window x:Class="AppWeather.Presentation.Views.DeleteDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Видалити прогноз погоди" Height="240" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=DateBox}">

    <Border Background="White" Padding="20">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Дата (РРРР-ММ-ДД):" 
                           FontWeight="SemiBold" 
                           FontSize="14" 
                           Margin="0,0,0,5"/>

                <Border CornerRadius="6" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <TextBox x:Name="DateBox"
                             Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,5"
                             FontSize="14"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding DateError}" 
                           Foreground="Red" 
                           FontSize="11" 
                           Margin="5,2,0,0"/>
            </StackPanel>

            <Button Content="Видалити"
                    Width="160"
                    Height="40"
                    HorizontalAlignment="Center"
                    Background="#0078D7"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Cursor="Hand"
                    BorderBrush="#E81123"
                    BorderThickness="0"
                    Command="{Binding DeleteCommand}"
                    Grid.Row="1"
                    Margin="0,10,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E81123"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#E81123"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#c8101f"/>
                                <Setter Property="BorderBrush" Value="#c8101f"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Border>
</Window>
