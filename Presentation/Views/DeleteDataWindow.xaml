<Window x:Class="AppWeather.Presentation.Views.DeleteDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Видалити прогноз погоди" Height="200" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Дата (рррр-мм-дд):"/>
            <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding DateError}" Foreground="Red" FontSize="12"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Видалити" HorizontalAlignment="Right" Padding="10,5"
                Command="{Binding DeleteCommand}" />
    </Grid>
</Window>
