<Window 
    x:Class="AppWeather.Presentation.Views.AuthorizationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Авторизація" Height="300" Width="400"
    WindowStartupLocation="CenterScreen"
    FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">

    <Border Background="White" Padding="20">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Логін:" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Margin="0,0,0,4"/>
                <Border CornerRadius="8" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,5"
                             FontSize="14"
                             BorderThickness="0"
                             KeyDown="OnKeyDown"
                             Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Пароль:" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Margin="0,0,0,4"/>
                <Border CornerRadius="8" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="35"
                                 Padding="10,5"
                                 FontSize="14"
                                 BorderThickness="0"
                                 PasswordChanged="OnPasswordChanged"
                                 KeyDown="OnKeyDown"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                </Border>
            </StackPanel>

            <Button Content="Увійти"
                    Width="140"
                    Height="40"
                    HorizontalAlignment="Center"
                    Background="#0078D7"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Cursor="Hand"
                    BorderBrush="#0078D7"
                    BorderThickness="0"
                    Command="{Binding LoginCommand}"
                    Grid.Row="4"
                    Margin="0,10,0,0"
                    Padding="10,2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Border>
</Window>
