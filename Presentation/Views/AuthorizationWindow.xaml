<Window x:Class="AppWeather.Presentation.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація" Height="250" Width="400"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Логін:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     KeyDown="OnKeyDown"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="30"
                         PasswordChanged="OnPasswordChanged"
                         KeyDown="OnKeyDown"
                         Margin="0,0,0,15"/>

            <Button Content="Увійти"
                    Width="300"
                    Height="35"
                    HorizontalAlignment="Right"
                    Command="{Binding LoginCommand}"/>
        </StackPanel>
    </Grid>
</Window>
