<Window x:Class="AppWeather.Presentation.Views.ChangeDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Змінити дані" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Background="White" Padding="20">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="320">

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Дата (РРРР-ММ-ДД):" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                <Border CornerRadius="8" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,5"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding DateError}" Foreground="Red" FontSize="11" Margin="5,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Температура:" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,4"/>
                <Border CornerRadius="8" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,5"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding TemperatureError}" Foreground="Red" FontSize="11" Margin="5,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Тиск:" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,4"/>
                <Border CornerRadius="8" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <TextBox Text="{Binding Pressure, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,5"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding PressureError}" Foreground="Red" FontSize="11" Margin="5,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Опади (так/ні):" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,4"/>
                <Border CornerRadius="8" BorderBrush="#ccc" BorderThickness="1" Background="White">
                    <TextBox Text="{Binding Precipitation, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,5"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding PrecipitationError}" Foreground="Red" FontSize="11" Margin="5,2,0,0"/>
            </StackPanel>

            <Button Content="Зберегти"
                    Width="180"
                    Height="40"
                    Background="#0078D7"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Cursor="Hand"
                    BorderBrush="#0078D7"
                    BorderThickness="0"
                    Command="{Binding ChangeCommand}"
                    Margin="0,10,0,0"
                    Padding="10,2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>
