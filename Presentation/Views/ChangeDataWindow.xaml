<Window x:Class="AppWeather.Presentation.Views.ChangeDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Змінити дані" Height="600" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Дата (РРРР-ММ-ДД):"/>
        <TextBox Grid.Row="1" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
        <TextBlock Grid.Row="2" Text="{Binding DateError}" Foreground="Red" FontSize="12"/>

        <TextBlock Grid.Row="3" Text="Температура:" Margin="0,15,0,0"/>
        <TextBox Grid.Row="4" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
        <TextBlock Grid.Row="5" Text="{Binding TemperatureError}" Foreground="Red" FontSize="12"/>

        <TextBlock Grid.Row="6" Text="Тиск:" Margin="0,15,0,0"/>
        <TextBox Grid.Row="7" Text="{Binding Pressure, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
        <TextBlock Grid.Row="8" Text="{Binding PressureError}" Foreground="Red" FontSize="12"/>

        <TextBlock Grid.Row="9" Text="Опади (так/ні):" Margin="0,15,0,0"/>
        <TextBox Grid.Row="10" Text="{Binding Precipitation, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
        <TextBlock Grid.Row="11" Text="{Binding PrecipitationError}" Foreground="Red" FontSize="12"/>

        <Button Grid.Row="12" Content="Зберегти" Command="{Binding ChangeCommand}" Margin="0,20,0,0"/>
    </Grid>
</Window>
